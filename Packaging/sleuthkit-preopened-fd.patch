@@ -52,0 +53,29 @@
+#ifndef TSK_WIN32
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* macOS can deny open("/dev/fd/N") when N refers to a raw device that was
+ * authorized and opened by authopen. Reopening is unnecessary: duplicate
+ * the inherited, already read-only descriptor instead. Ordinary paths are
+ * still opened with open(..., O_RDONLY ...). */
+int
+raw_open_readonly(const char *path)
+{
+	static const char prefix[] = "/dev/fd/";
+	char *end = NULL;
+	long inherited_fd;
+	if (strncmp(path, prefix, sizeof(prefix) - 1) == 0) {
+		inherited_fd = strtol(path + sizeof(prefix) - 1, &end, 10);
+		if (end != path + sizeof(prefix) - 1 && *end == '\0' &&
+			inherited_fd >= STDIN_FILENO && inherited_fd <= INT_MAX) {
+			return dup((int)inherited_fd);
+		}
+		errno = EINVAL;
+		return -1;
+	}
+	return open(path, O_RDONLY | O_BINARY);
+}
+#endif
+
